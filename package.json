{
  "name": "uncbox",
  "private": true,
  "version": "0.2.0",
  "description": "A locally hosted stream dashboard: your game, chat, friends and music in one themed, rearrangeable layout.",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "serve": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "notices": "node scripts/notices.mjs",
    "test": "vitest run",
    "check": "node scripts/check.mjs",
    "setup-domain": "node scripts/setup-domain.mjs",
    "remove-domain": "node scripts/setup-domain.mjs --remove",
    "app": "node scripts/app.mjs",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/cascadia-mono": "^5.3.0",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "hero-patterns": "^2.1.0",
    "mediabunny": "1.61.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0"
  },
  "devDependencies": {
    "@types/dom-mediacapture-transform": "0.1.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
