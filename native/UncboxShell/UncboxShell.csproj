<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Uncbox</AssemblyName>
    <ApplicationIcon>uncbox.ico</ApplicationIcon>
    <RootNamespace>UncboxShell</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Shown in Settings > Apps. npm run package stamps package.json's version over this (-p:Version). -->
    <Version>0.2.0</Version>
    <!-- WebView2 also ships a WPF control this app does not use; its WindowsBase version clash is harmless. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!-- The Setup exe (npm run package -p:PayloadZip=...) carries node\ and app\ as a zip inside itself. -->
  <ItemGroup Condition="'$(PayloadZip)' != ''">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="UncboxPayload.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- WASAPI capture: desktop sound and the mic for the stream (StreamAudio.cs), and the sound of clips (ClipAudio.cs). -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
